# Production settings for AWS. Do not commit real values: in ECS put secrets into the task definition
# from AWS Secrets Manager / SSM Parameter Store, plain values as environment variables.
# Everything not listed falls back to the production defaults (see backend/internal/config/config.go).

APP_ENV=production
AWS_REGION=eu-central-1

# --- secrets (Secrets Manager) ---
JWT_SECRET=change-me-64-random-characters
POSTGRES_PASSWORD=change-me
# REDIS_PASSWORD=change-me            # ElastiCache AUTH token or RBAC user password, if enabled

# --- Amazon RDS for PostgreSQL 17 ---
POSTGRES_HOST=oneboard.xxxxxxxx.eu-central-1.rds.amazonaws.com:5432
POSTGRES_USER=oneboard
POSTGRES_DB=oneboard
# POSTGRES_SSLMODE=verify-full        # default in production; the RDS CA bundle is baked into the image
# DATABASE_URL=postgres://…           # alternative to the POSTGRES_* variables

# --- Amazon ElastiCache (Valkey / Redis OSS, cluster mode DISABLED) ---
REDIS_ADDR=master.oneboard.xxxxxx.euc1.cache.amazonaws.com:6379
# REDIS_TLS=1                         # default in production (in-transit encryption)
# REDIS_USERNAME=oneboard             # if RBAC is used

# --- Amazon OpenSearch Service ---
OPENSEARCH_URL=https://search-oneboard-xxxxxxxx.eu-central-1.es.amazonaws.com
# OPENSEARCH_AUTH=aws                 # default when no password is set: SigV4 with the task role
# OPENSEARCH_SERVICE=es               # "aoss" for OpenSearch Serverless
# OPENSEARCH_REPLICAS=1
# OPENSEARCH_USER / OPENSEARCH_PASSWORD with OPENSEARCH_AUTH=basic for a fine-grained-access master user

# --- Amazon S3 (credentials come from the task role) ---
S3_BUCKET=oneboard-files-prod

# --- HTTP ---
# ADDR=:8080
# SECURE_COOKIES=1                    # default in production; the ALB terminates HTTPS
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=720h
